            "source": [
                "#Test Model on Full CSV\n",
                "\n",
                "test_csv = Path.cwd() / \"data\" / \"04-21note.csv\"\n",
                "test_df = pd.read_csv(test_csv)\n",
                "\n",
                "# test_df['occupied_note'] = test_df['occupied_note'].astype(int)\n",
                "\n",
                "\n",
                "test_df['time_interval'] = (test_df['second'] - 1) // 5\n",
                "\n",
                "aggregated_test = test_df.groupby('time_interval').agg({\n",
                "    'distance':      'mean',\n",
                "    'motion':        'mean',\n",
                "    'lightIntensity':'mean',\n",
                "    'occupied':      lambda x: x.mode().iloc[0],\n",
                "    'occupied_note': lambda x: x.mode().iloc[0]\n",
                "}).reset_index()\n",
                "\n",
                "\n",
                "X_test_full = aggregated_test[['distance', 'motion', 'lightIntensity', 'occupied']]\n",
                "y_test_full = aggregated_test['occupied_note']\n",
                "\n",
                "#predict on the full CSV\n",
                "y_pred_full = best_clf.predict(X_test_full)\n",
                "y_proba_full = best_clf.predict_proba(X_test_full)[:, 1]\n",
                "\n",
                "print(\"Classification Report:\")\n",
                "print(classification_report(y_test_full, y_pred_full))\n",
                "\n",
                "print(\"Confusion Matrix:\")\n",
                "print(confusion_matrix(y_test_full, y_pred_full))\n",
                "\n",
                "roc_auc = roc_auc_score(y_test_full, y_proba_full)\n",
                "print(f\"ROC AUC Score: {roc_auc:.2f}\")\n"
            ]
        },
